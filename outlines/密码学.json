{
 "chapters": [
  {
   "title": "第1章 概述",
   "topics": [
    {
     "id": "信息安全目标与攻击分类",
     "title": "信息安全的目标、安全攻击的主要形式和分类（被动攻击与主动攻击）",
     "requires": []
    },
    {
     "id": "密码体制要素与模型",
     "title": "加密系统模型与密码体制的要素（明文空间、密文空间、密钥空间等）",
     "requires": []
    },
    {
     "id": "密码体制分类",
     "title": "根据密钥特性对密码体制的分类（对称密码与非对称密码）",
     "requires": [
      "密码体制要素与模型"
     ]
    },
    {
     "id": "密码分析学基础",
     "title": "密码分析学概念及密码攻击类型（唯密文攻击、已知明文攻击、选择明文攻击、选择密文攻击）",
     "requires": [
      "密码体制要素与模型"
     ]
    },
    {
     "id": "密码体制安全性",
     "title": "密码体制的安全性分类（无条件安全与计算安全）及信息论不等式 I(P;C)≥H(P)-H(K)",
     "requires": [
      "密码分析学基础"
     ]
    },
    {
     "id": "密码学发展简史",
     "title": "密码学发展简史（近代密码时期与现代密码学概念的发展）",
     "requires": []
    }
   ]
  },
  {
   "title": "第2章 数学背景",
   "topics": [
    {
